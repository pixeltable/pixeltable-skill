{
  "description": "Pixeltable: session orientation + real-time anti-pattern validation (pure Python; python_hook.sh finds a 3.9+ interpreter that can read the hook file).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_orientation.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/validate_antipatterns.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
